<Window x:Class="Autoservice3.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Autoservice3"
        mc:Ignorable="d"
        Title="Авторизация" Height="200" Width="350" Background="PowderBlue">
    <Grid>
        <!--Определения строк-->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="4*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Content="Логин" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBox x:Name="txtLogin" Grid.Column="1" Grid.Row="0" Width="Auto"  Height="25" Margin="0 10 10 10"/>
        <Label Grid.Column="0" Grid.Row="1" Content="Пароль" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
        <PasswordBox x:Name="pwdPassword" Grid.Column="1" Grid.Row="1" Width="Auto"  Height="25" Margin="0 10 10 10"/>
        <StackPanel Margin="10 20 0 30" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" Width="Auto">
            <Button  Content="Войти" Padding="20 5 20 5" Width="Auto"   Background="Lavender" Click="Button_Login"/>
            <Button  Content="Отмена" Padding="20 5 20 5" Width="Auto"  Margin="80 0 10 0" Background="OrangeRed" Click="Button_Esc"/>
        </StackPanel>
    </Grid>
</Window>

